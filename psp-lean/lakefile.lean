import Lake
open Lake DSL

/-- Aeneas Lean backend, same commit as the pinned charon/aeneas binaries in
    ~/source/aeneas-namma-cloud/.tools (built packages are reused from that project via
    the .lake/packages symlink). -/
require aeneas from git
  "https://github.com/AeneasVerif/aeneas.git" @ "0855ce1b8ed3958512b6c19de6bf3035b7acb552" / "backends/lean"

package «psp-lean» {}

/-- Generated by Aeneas from ../psp-flow (do not edit). -/
@[default_target] lean_lib PspFlow {}

/-- Hand-written proofs of P1..P5 about the generated model. -/
@[default_target] lean_lib PspProofs {}

/-- Generated by Aeneas from ../psp-flow-dsl, the flow! macro version (do not edit). -/
@[default_target] lean_lib PspFlowDsl {}

/-- The same proofs against the macro version's model, derived from PspProofs by
    scripts/translate-psp.sh. -/
@[default_target] lean_lib PspProofsDsl {}
