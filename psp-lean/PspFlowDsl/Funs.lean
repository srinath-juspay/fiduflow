@[global_simps, irreducible]
def values.MAX_AMOUNT_PAISE : Std.U64 := 10000000#u64

/-- [psp_flow_dsl::machine::validate_pay_intent]:
    Source: 'psp-flow-dsl/src/lib.rs', lines 19:0-145:1
    Visibility: public -/
def machine.validate_pay_intent
  (payer : values.PayerId) (raw : values.RawIntent) :
  Result (core.result.Result values.ValidIntent values.Reason)
  := do
  let i := raw.amount
  if i = 0#u64
  then ok (core.result.Result.Err values.Reason.InvalidAmount)
  else
    if i > values.MAX_AMOUNT_PAISE
    then ok (core.result.Result.Err values.Reason.InvalidAmount)
    else
      let i1 := raw.payee
      if i1 = 0#u64
      then ok (core.result.Result.Err values.Reason.UnknownPayee)
      else
        if i1 = payer
        then ok (core.result.Result.Err values.Reason.PayeeIsPayer)
        else
          ok (core.result.Result.Ok
            { payee := raw.payee, amount := raw.amount })

